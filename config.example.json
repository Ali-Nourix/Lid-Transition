{
  "version": 1,
  "animation": {
    "enableAnimation": true,
    "useHingeAngleWhenAvailable": true,
    "useInclinometerWhenAvailable": true,
    "allowInclinometerEarlyClose": false,
    "inclinometerCalibration": {
      "openPitchDegrees": 0,
      "closedPitchDegrees": 0,
      "isValid": false
    },
    "hingeClosedAngleDeg": 4,
    "hingeOpenAngleDeg": 55,
    "hingeVelocityReference": 3,
    "closeDurationMs": 340,
    "openDurationMs": 285,
    "panelMaxAngleDeg": 90,
    "perspectiveStrength": 0.85,
    "hingeOffset": 0.05,
    "edgeSoftness": 2.6,
    "maxBlur": 56,
    "blurFalloff": 1.15,
    "blurVelocityInfluence": 0.72,
    "blackOpacity": 1,
    "shadowStrength": 0.55,
    "shadowFalloff": 1.6,
    "glareStrength": 0.055,
    "glareWidth": 0.1,
    "distortionStrength": 0.5,
    "offAxisWash": 0.35,
    "globalDim": 0.1,
    "bezelAmbient": 0.01,
    "bezelFalloffPx": 22,
    "enableBlur": true,
    "enableShadow": true,
    "enableDistortion": true,
    "enableGlare": true,
    "enableDither": true,
    "quality": "Balanced",
    "closeEasing": {
      "preset": "LidClose",
      "bezier": [
        0.24,
        0.92,
        0.2,
        1
      ],
      "springDamping": 1,
      "springFrequency": 3.2
    },
    "openEasing": {
      "preset": "LidOpen",
      "bezier": [
        0.14,
        0.98,
        0.24,
        1
      ],
      "springDamping": 1,
      "springFrequency": 3.2
    }
  },
  "monitor": {
    "mode": "InternalPanel",
    "manualDisplayId": null,
    "allowExternalDisplays": false
  },
  "behavior": {
    "startWithWindows": false,
    "skipWhenFullscreenAppActive": true,
    "enablePreviewHotkeys": true,
    "warmCapture": false,
    "captureTimeoutMs": 45,
    "captureBackend": "Auto",
    "includeCursorInSnapshot": true
  },
  "diagnostics": {
    "showDebugHud": false,
    "enableFileLogging": true,
    "verboseFrameLogging": false,
    "previewHoldMs": 350
  }
}