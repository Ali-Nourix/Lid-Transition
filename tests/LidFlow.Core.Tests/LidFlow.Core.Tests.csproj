<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Plain net8.0 so the whole suite runs on any OS and in CI without a GPU or a display.
      Everything worth testing (animation maths, state machine, easing, monitor selection,
      configuration) lives in LidFlow.Core precisely so that this is possible.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>LidFlow.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LidFlow.Core\LidFlow.Core.csproj" />
  </ItemGroup>

</Project>
